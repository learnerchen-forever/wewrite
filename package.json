{
  "name": "obsidian-wewrite",
  "version": "2.0.21",
  "description": "全平台写作工具，随时随地创作微信公众号文章，轻松定制你的个性化文章风格。",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest --config jest.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "changelog": "node tools/changelog.js release",
    "changelog:note": "node tools/changelog.js note",
    "changelog:preview": "node tools/changelog.js preview",
    "changelog:sync": "node tools/changelog.js sync",
    "changelog:check": "node tools/changelog.js check",
    "themes:scan": "node tools/scan-themes.mjs",
    "themes:check": "node tools/scan-themes.mjs --check",
    "check:bundle": "node tools/check-bundle.mjs main.js src"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "mathjax-full": "^3.2.1",
    "webdav": "^5.10.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "0.14.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "obsidian": "latest",
    "ts-jest": "^29.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
